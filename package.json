{
  "name": "salli-manager",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "engines": { "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0" },
  "scripts": {
    "start": "node scripts/expo.mjs development start --dev-client",
    "android": "node scripts/expo.mjs development run:android",
    "prebuild:development": "node scripts/expo.mjs development prebuild --platform android --no-install",
    "prebuild:release": "node scripts/expo.mjs release prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "check:config": "node scripts/check-config.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "export:android": "node scripts/expo.mjs release export --platform android",
    "config:release": "node scripts/expo.mjs release config --type public"
  },
  "dependencies": {
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.20",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.25",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
